# Copy to .env.local and fill in. Set the same three in the Vercel
# project (Settings -> Environment Variables) before deploying.

# Supabase — project "Nebkern Technology" (asamjimvshjwwndjjeef).
# Public by design: the publishable key can only read published posts.
NEXT_PUBLIC_SUPABASE_URL=https://asamjimvshjwwndjjeef.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_tRZ4fUfJEHC1K1haMcpcBA_nxlyTQLg

# SECRET — bypasses Row Level Security. Server only; never commit it.
# Supabase dashboard -> Project Settings -> API Keys -> Secret keys.
SUPABASE_SECRET_KEY=

# Admin sign-in. Without these the admin falls back to publicly known
# defaults in lib/admin-auth.ts — set all three before going live.
ADMIN_USERNAME=
ADMIN_PASSWORD=
ADMIN_SESSION_SECRET=

# Maya playground (/maya-playground). An Anthropic API key from
# console.anthropic.com. SECRET — server only. Without it the page says
# the playground isn't switched on yet. Set a monthly spend limit on
# this key's workspace in the Claude Console: that is the real cap on
# what a public demo can cost.
ANTHROPIC_API_KEY=
# Optional. Defaults to claude-opus-5. claude-haiku-4-5 is Maya's own
# default for Anthropic keys in Instant, and roughly a fifth the cost.
MAYA_PLAYGROUND_MODEL=
